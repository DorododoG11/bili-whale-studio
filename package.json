{
  "name": "dsh-bili-whale-studio",
  "version": "0.2.0",
  "description": "大肥鱼工作室：让 DSH 里的 agent 在 B 站自学、整理自己的声音、把内容做成动态和视频，草稿经人点头才发。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "agent",
    "tts",
    "studio"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
